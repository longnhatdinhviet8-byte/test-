@model test.Models.ThanhToanKhachViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Cau
@{
    var hd = Model.HoaDon;
    ViewData["Title"] = "Thanh toán hóa đơn #" + hd.MaHD;

    var maNganHang = Cau["ThanhToanQR:MaNganHang"] ?? "";
    var soTaiKhoan = Cau["ThanhToanQR:SoTaiKhoan"] ?? "";
    var tenChuTK = Cau["ThanhToanQR:TenChuTaiKhoan"] ?? "";
    var daCauHinhQR = maNganHang != "" && soTaiKhoan != "";

    var conLai = decimal.Truncate(Model.ConLai);
    var noiDung = "HD" + hd.MaHD;
    var cho = Model.ChoXacNhan;
    var dangMo = hd.TrangThai == test.Models.TrangThaiHoaDon.ChuaThanhToan;

    // Ảnh mã QR do VietQR tạo, đã nhúng sẵn số tiền còn lại và nội dung chuyển khoản
    var anhQR = daCauHinhQR
        ? $"https://img.vietqr.io/image/{Uri.EscapeDataString(maNganHang)}-{Uri.EscapeDataString(soTaiKhoan)}-compact2.png"
          + $"?amount={(long)conLai}&addInfo={Uri.EscapeDataString(noiDung)}&accountName={Uri.EscapeDataString(tenChuTK)}"
        : "";
}

<div class="page-header text-center">
    <h1>💳 Thanh toán hóa đơn #@hd.MaHD</h1>
    <p class="mb-0">Bàn <strong>@hd.Ban.SoBan</strong>@if (hd.DatBan != null) { <text> · Lịch đặt bàn @hd.DatBan.NgayGio.ToString("HH:mm dd/MM/yyyy")</text> }</p>
</div>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success">@thongBao</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger">@loi</div>
}

<div class="table-responsive">
    <table class="table bg-white align-middle">
        <thead>
            <tr>
                <th>Món</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Số lượng</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in hd.ChiTietHoaDons.OrderBy(x => x.MonAn.TenMon))
            {
                <tr>
                    <td>@c.MonAn.TenMon</td>
                    <td class="text-end">@string.Format("{0:N0}", c.DonGia) đ</td>
                    <td class="text-end">@c.SoLuong</td>
                    <td class="text-end">@string.Format("{0:N0}", c.SoLuong * c.DonGia) đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-bold">Tổng tiền</td>
                <td class="text-end fw-bold">@string.Format("{0:N0}", hd.TongTien) đ</td>
            </tr>
            <tr>
                <td colspan="3" class="text-end">Đã thanh toán</td>
                <td class="text-end">@string.Format("{0:N0}", Model.DaTra) đ</td>
            </tr>
            <tr>
                <td colspan="3" class="text-end fw-bold">Còn lại</td>
                <td class="text-end fw-bold price-tag">@string.Format("{0:N0}", Model.ConLai) đ</td>
            </tr>
        </tfoot>
    </table>
</div>

@if (hd.TrangThai == test.Models.TrangThaiHoaDon.DaThanhToan)
{
    <div class="alert alert-success text-center fs-5">✅ Hóa đơn đã được thanh toán đủ. Cảm ơn bạn!</div>
}
else if (hd.TrangThai == test.Models.TrangThaiHoaDon.DaHuy)
{
    <div class="alert alert-secondary text-center">Hóa đơn này đã bị hủy.</div>
}
else if (hd.TongTien <= 0)
{
    <div class="alert alert-info text-center">Hóa đơn chưa có món nào. Hãy chọn món trước khi thanh toán.</div>
}
else if (cho != null)
{
    <div class="alert alert-info text-center">
        ⏳ Bạn đã báo chuyển khoản <strong>@string.Format("{0:N0}", cho.SoTien) đ</strong> lúc @cho.NgayTT.ToString("HH:mm dd/MM/yyyy").<br />
        Nhà hàng đang kiểm tra tiền về tài khoản. Trang này sẽ cập nhật khi nhân viên xác nhận (bấm F5 để tải lại).
    </div>
}
else if (conLai > 0)
{
    <div class="card card-food p-4 mx-auto text-center" style="max-width: 460px;">
        @if (daCauHinhQR)
        {
            <h5 class="mb-2">Quét mã QR bằng app ngân hàng</h5>
            <img src="@anhQR" alt="Mã QR chuyển khoản" class="img-fluid mb-3" />
            <div class="small text-muted mb-3">
                Chủ tài khoản: <strong>@tenChuTK</strong><br />
                Số tài khoản: <strong>@soTaiKhoan</strong><br />
                Số tiền: <strong>@string.Format("{0:N0}", conLai) đ</strong><br />
                Nội dung chuyển khoản: <strong>@noiDung</strong> (giữ nguyên để nhà hàng nhận ra hóa đơn của bạn)
            </div>

            <form asp-action="DaChuyenKhoan" asp-route-id="@hd.MaHD" method="post"
                  onsubmit="return confirm('Bạn đã chuyển khoản xong và muốn báo cho nhà hàng?');">
                <button type="submit" class="btn btn-restaurant btn-lg w-100">Tôi đã chuyển khoản</button>
            </form>
            <p class="small text-muted mt-3 mb-0">
                Chỉ bấm sau khi đã chuyển tiền. Nhà hàng sẽ đối chiếu với tài khoản ngân hàng trước khi xác nhận.
                Bạn cũng có thể thanh toán tiền mặt cho nhân viên.
            </p>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                Nhà hàng chưa cấu hình tài khoản nhận tiền nên chưa tạo được mã QR. Vui lòng thanh toán trực tiếp cho nhân viên.
            </div>
        }
    </div>
}

@if (Model.ThanhToans.Any())
{
    <h5 class="section-title mt-4 mb-2">Lịch sử thanh toán</h5>
    <div class="table-responsive">
        <table class="table bg-white align-middle">
            <thead>
                <tr><th>Thời gian</th><th>Hình thức</th><th class="text-end">Số tiền</th><th>Trạng thái</th></tr>
            </thead>
            <tbody>
                @foreach (var t in Model.ThanhToans)
                {
                    <tr>
                        <td>@t.NgayTT.ToString("HH:mm dd/MM/yyyy")</td>
                        <td>@t.PhuongThuc</td>
                        <td class="text-end">@string.Format("{0:N0}", t.SoTien) đ</td>
                        <td>@t.TrangThai</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-controller="DatBan" asp-action="CuaToi" class="btn btn-outline-secondary">← Lịch đặt bàn của tôi</a>
</div>
